SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Must match a Redirect URI registered in your Spotify app. Spotify requires 127.0.0.1, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me
# Optional: turns on game-name normalization. Free key from https://rawg.io/apidocs
# Leave it empty (or delete the line) to use titles exactly as typed.
RAWG_API_KEY=your_api_key_here
# Optional: adds Last.fm community scrobble/listener counts to the track chooser.
# Create a free API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=